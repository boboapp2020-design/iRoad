function newId() {
  return Utilities.getUuid();
}

var UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

function isUuid(v) {
  return typeof v === 'string' && UUID_RE.test(v);
}

function toUnsignedBytes(bytes) {
  var out = new Array(bytes.length);
  for (var i = 0; i < bytes.length; i++) out[i] = bytes[i] & 0xff;
  return out;
}

function bytesToHex(bytes) {
  var s = '';
  for (var i = 0; i < bytes.length; i++) {
    var b = bytes[i] & 0xff;
    s += (b < 16 ? '0' : '') + b.toString(16);
  }
  return s;
}

function sha256Hex(input) {
  return bytesToHex(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, input, Utilities.Charset.UTF_8));
}

function sha256HexBytes(bytes) {
  return bytesToHex(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes));
}

/** 64 hex chars of randomness derived from two random UUIDs. */
function randomToken() {
  return sha256Hex(Utilities.getUuid() + ':' + Utilities.getUuid() + ':' + new Date().getTime());
}

/** Constant-time string comparison for hashes. */
function safeEqual(a, b) {
  a = String(a);
  b = String(b);
  var diff = a.length ^ b.length;
  var n = Math.max(a.length, b.length);
  for (var i = 0; i < n; i++) diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
  return diff === 0;
}

function parseJsonSafe(text, fallback) {
  if (text === '' || text === null || text === undefined) return fallback;
  try {
    return JSON.parse(text);
  } catch (e) {
    return fallback;
  }
}

/* ---------------------------------------------------------------- input */

function reqString(obj, key, opts) {
  opts = opts || {};
  var v = obj ? obj[key] : undefined;
  if (v === undefined || v === null || v === '') {
    if (opts.optional) return '';
    fail('VALIDATION_ERROR', key + ' is required', { field: key });
  }
  if (typeof v !== 'string') fail('VALIDATION_ERROR', key + ' must be a string', { field: key });
  v = v.trim();
  var max = opts.max || LIMITS.maxShortTextLength;
  if (v.length > max) fail('VALIDATION_ERROR', key + ' is too long (max ' + max + ')', { field: key });
  if (!opts.optional && v === '') fail('VALIDATION_ERROR', key + ' is required', { field: key });
  if (opts.min && v.length < opts.min) fail('VALIDATION_ERROR', key + ' is too short (min ' + opts.min + ')', { field: key });
  if (opts.oneOf && opts.oneOf.indexOf(v) < 0) fail('VALIDATION_ERROR', key + ' has an invalid value', { field: key });
  return v;
}

/** Optional finite number (null when absent). Never coerces missing values to 0. */
function optNumber(obj, key) {
  var v = obj ? obj[key] : undefined;
  if (v === undefined || v === null || v === '') return null;
  if (typeof v !== 'number' || !isFinite(v)) fail('VALIDATION_ERROR', key + ' must be a finite number', { field: key });
  return v;
}

function optTimestamp(obj, key) {
  var v = obj ? obj[key] : undefined;
  if (v === undefined || v === null || v === '') return null;
  var ms = typeof v === 'number' ? v : Date.parse(v);
  if (!isFinite(ms)) fail('VALIDATION_ERROR', key + ' must be a timestamp', { field: key });
  return new Date(ms).toISOString();
}

function normalizeEmail(email) {
  var e = String(email || '').trim().toLowerCase();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e) || e.length > 254) fail('VALIDATION_ERROR', 'Invalid email address', { field: 'email' });
  return e;
}

/* ---------------------------------------------------------------- cells */

/**
 * Serialize a value for storage. Everything is stored as plain text (the
 * sheets use the "@" number format) and strings that a spreadsheet could
 * interpret as a formula are prefixed with an apostrophe.
 */
function toCell(v) {
  if (v === null || v === undefined) return '';
  if (typeof v === 'boolean') return v ? 'TRUE' : 'FALSE';
  if (typeof v === 'number') return isFinite(v) ? String(v) : '';
  if (typeof v === 'object') v = JSON.stringify(v);
  v = String(v);
  if (/^[=+\-@\t\r]/.test(v)) return "'" + v;
  return v;
}

function fromCell(v) {
  if (v === null || v === undefined) return '';
  if (v instanceof Date) return v.toISOString();
  v = String(v);
  // Undo the formula-escape apostrophe if the spreadsheet kept it literally.
  if (/^'[=+\-@\t\r]/.test(v)) v = v.slice(1);
  return v;
}

/** The exact string a value reads back as after a round trip through a cell. */
function normalizedCell(v) {
  return fromCell(toCell(v));
}

function cellNumber(v) {
  if (v === '' || v === null || v === undefined) return null;
  var n = Number(v);
  return isFinite(n) ? n : null;
}

function cellBool(v) {
  if (v === 'TRUE' || v === true) return true;
  if (v === 'FALSE' || v === false) return false;
  return null;
}

/* ===== 02_Db.js ===== */
/**
 * Minimal table layer over Google Sheets. Row 1 holds headers; every value
 * is stored as text. Reads are cached for the duration of one request.
 * All writes happen while the caller holds the script lock (see withLock).
 */
var Db = (function () {
  var ss_ = null;
  var cache_ = {};

  function spreadsheet() {
    if (ss_) return ss_;
    // Container-bound script: the bound spreadsheet is available in doPost too,
    // which lets the manifest request only the spreadsheets.currentonly scope.
    ss_ = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss_) fail('NOT_CONFIGURED', 'This script must be bound to the spreadsheet (Extensions > Apps Script).');
    return ss_;
  }

  function sheet(name) {
    var sh = spreadsheet().getSheetByName(name);
    if (!sh) fail('NOT_CONFIGURED', 'Missing sheet "' + name + '". Run setup() first.');
    return sh;
  }

  function columns(name) {
    if (!SCHEMA[name]) fail('INTERNAL', 'Unknown table ' + name);
    return SCHEMA[name].columns;
  }

  function all(name) {
    if (cache_[name]) return cache_[name];
    var sh = sheet(name);
    var cols = columns(name);
    var last = sh.getLastRow();
    var rows = [];
    if (last >= 2) {
      var header = sh.getRange(1, 1, 1, cols.length).getValues()[0].map(fromCell);
      for (var c = 0; c < cols.length; c++) {
        if (header[c] !== cols[c]) fail('SCHEMA_MISMATCH', 'Sheet "' + name + '" column ' + (c + 1) + ' should be "' + cols[c] + '"');
      }
      var values = sh.getRange(2, 1, last - 1, cols.length).getValues();
      for (var r = 0; r < values.length; r++) {
        var obj = { _row: r + 2 };
        for (var k = 0; k < cols.length; k++) obj[cols[k]] = fromCell(values[r][k]);
        rows.push(obj);
      }
    }
    cache_[name] = rows;
    return rows;
  }

  function find(name, predicate) {
    var rows = all(name);
    for (var i = 0; i < rows.length; i++) if (predicate(rows[i])) return rows[i];
    return null;
  }

  function filter(name, predicate) {
    return all(name).filter(predicate);
  }

  function byId(name, id) {
    if (!id) return null;
    return find(name, function (r) { return r.id === id; });
  }

  /** Append rows (array of plain objects). Returns the stored objects. */
  function insert(name, objs) {
    if (!objs.length) return [];
    var sh = sheet(name);
    var cols = columns(name);
    var start = Math.max(sh.getLastRow(), 1) + 1;
    var values = objs.map(function (o) {
      return cols.map(function (c) { return toCell(o[c]); });
    });
    sh.getRange(start, 1, values.length, cols.length).setValues(values);
    var stored = objs.map(function (o, i) {
      var row = { _row: start + i };
      cols.forEach(function (c) { row[c] = normalizedCell(o[c]); });
      return row;
    });
    if (cache_[name]) cache_[name] = cache_[name].concat(stored);
    return stored;
  }

  /**
   * Update selected columns of an existing row. `allowed` is the explicit
   * list of mutable columns — immutable evidence columns are never passed.
   */
  function update(name, row, patch, allowed) {
    var sh = sheet(name);
    var cols = columns(name);
    Object.keys(patch).forEach(function (key) {
      if (allowed.indexOf(key) < 0) fail('INTERNAL', 'Column ' + name + '.' + key + ' is not updatable');
      var c = cols.indexOf(key);
      if (c < 0) fail('INTERNAL', 'Unknown column ' + key);
      sh.getRange(row._row, c + 1, 1, 1).setValues([[toCell(patch[key])]]);
      row[key] = normalizedCell(patch[key]);
    });
    return row;
  }

  function reset() {
    cache_ = {};
    ss_ = null;
  }

  return { spreadsheet: spreadsheet, sheet: sheet, all: all, find: find, filter: filter, byId: byId, insert: insert, update: update, reset: reset };
})();

/** Run fn while holding the script-wide lock (serializes all writes). */
function withLock(fn) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(LIMITS.lockWaitMs)) fail('BUSY', 'Server is busy, please retry.');
  try {
    Db.reset(); // re-read after acquiring the lock so decisions use fresh data
    return fn();
  } finally {
    lock.releaseLock();
  }
}

/** Hash of the immutable columns of an evidence record (tamper evidence). */
function recordHash(table, obj) {
  var cols = SCHEMA[table].hashed;
  var parts = cols.map(function (c) { return c + '=' + normalizedCell(obj[c]); });
  return sha256Hex(table + '|' + parts.join('|'));
}

/* ===== 03_Crypto.js ===== */
/**
 * PBKDF2-HMAC-SHA256 implemented on Utilities.computeHmacSha256Signature
 * (Apps Script has no native PBKDF2). Byte arrays from Apps Script are
 * signed Java bytes; values are masked to 0..255 where it matters.
 */
function pbkdf2Sha256(passwordBytes, saltBytes, iterations, dkLen) {
  dkLen = dkLen || 32;
  var blocks = Math.ceil(dkLen / 32);
  var out = [];
  for (var block = 1; block <= blocks; block++) {
    var msg = saltBytes.concat([(block >>> 24) & 0xff, (block >>> 16) & 0xff, (block >>> 8) & 0xff, block & 0xff]);
    var u = Utilities.computeHmacSha256Signature(toSignedBytes(msg), toSignedBytes(passwordBytes));
    var t = toUnsignedBytes(u);
    for (var i = 1; i < iterations; i++) {
      u = Utilities.computeHmacSha256Signature(u, toSignedBytes(passwordBytes));
      for (var j = 0; j < t.length; j++) t[j] ^= u[j] & 0xff;
    }
    out = out.concat(t);
  }
  return out.slice(0, dkLen);
}

function toSignedBytes(bytes) {
  return bytes.map(function (b) { b = b & 0xff; return b > 127 ? b - 256 : b; });
}

function utf8Bytes(str) {
  return toUnsignedBytes(Utilities.newBlob(String(str)).getBytes());
}

function hexToBytes(hex) {
  var out = [];
  for (var i = 0; i < hex.length; i += 2) out.push(parseInt(hex.substr(i, 2), 16));
  return out;
}

function hashPassword(password, saltHex, iterations) {
  saltHex = saltHex || randomToken().slice(0, 32);
  iterations = iterations || LIMITS.pbkdf2Iterations;
  var dk = pbkdf2Sha256(utf8Bytes(password), hexToBytes(saltHex), iterations, 32);
  return { hash: bytesToHex(dk), salt: saltHex, iterations: iterations };
}

function verifyPassword(password, user) {
  if (!user.password_hash || !user.password_salt) return false;
  var iterations = Number(user.password_iterations) || LIMITS.pbkdf2Iterations;
  var h = hashPassword(password, user.password_salt, iterations);
  return safeEqual(h.hash, user.password_hash);
}

function validateNewPassword(password) {
  if (typeof password !== 'string' || password.length < LIMITS.minPasswordLength) {
    fail('WEAK_PASSWORD', 'Password must be at least ' + LIMITS.minPasswordLength + ' characters.');
  }
  if (password.length > 256) fail('WEAK_PASSWORD', 'Password is too long.');
  if (!/[A-Za-z]/.test(password) || !/[0-9]/.test(password)) {
    fail('WEAK_PASSWORD', 'Password must contain letters and numbers.');
  }
}

/** Human-friendly random temporary password (letters + digits). */
function generateTempPassword() {
  var alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
  var bytes = hexToBytes(randomToken());
  var s = '';
  for (var i = 0; i < 14; i++) s += alphabet[bytes[i] % alphabet.length];
  return s.slice(0, 7) + '-' + s.slice(7) + '7';
}

/* ===== 04_Auth.js ===== */
function getSetting(key) {
  var row = Db.find('settings', function (r) { return r.key === key; });
  if (row) return row.value;
  return Object.prototype.hasOwnProperty.call(SETTINGS_DEFAULTS, key) ? SETTINGS_DEFAULTS[key] : null;
}

/** Public projection of a user row — never includes credential fields. */
function publicUser(u) {
  if (!u) return null;
  return {
    id: u.id,
    email: u.email,
    full_name: u.full_name,
    role: u.role,
    active: u.active === 'TRUE',
    must_change_password: u.must_change_password === 'TRUE',
    created_at: u.created_at,
    updated_at: u.updated_at
  };
}

function userById(id) {
  return Db.byId('users', id);
}

function userByEmail(email) {
  return Db.find('users', function (r) { return r.email === email; });
}

function createSession(user, userAgent) {
  var token = randomToken();
  var ttlHours = Math.min(Math.max(Number(getSetting('session_ttl_hours')) || 12, 1), 72);
  var now = new Date();
  var expires = new Date(now.getTime() + ttlHours * 3600 * 1000);
  Db.insert('sessions', [{
    token_hash: sha256Hex(token),
    user_id: user.id,
    created_at: now.toISOString(),
    expires_at: expires.toISOString(),
    revoked_at: '',
    user_agent: String(userAgent || '').slice(0, 200)
  }]);
  return { token: token, expires_at: expires.toISOString() };
}

/**
 * Resolve the bearer token to an active user. Throws UNAUTHENTICATED for a
 * missing, unknown, expired or revoked session, or a disabled account.
 */
function authenticate(token) {
  if (typeof token !== 'string' || !/^[0-9a-f]{64}$/.test(token)) fail('UNAUTHENTICATED', 'Please sign in.');
  var hash = sha256Hex(token);
  var session = Db.find('sessions', function (r) { return r.token_hash === hash; });
  if (!session || session.revoked_at || Date.parse(session.expires_at) <= Date.now()) {
    fail('UNAUTHENTICATED', 'Your session has expired. Please sign in again.');
  }
  var user = userById(session.user_id);
  if (!user || user.active !== 'TRUE' || ROLES.indexOf(user.role) < 0) fail('UNAUTHENTICATED', 'Account is disabled.');
  return { user: user, session: session };
}

function requireRole(user, roles) {
  if (roles.indexOf(user.role) < 0) fail('FORBIDDEN', 'You do not have permission for this action.');
}

/* ------------------------------------------------------------- actions */

function actionLogin(p, ctx) {
  var email = normalizeEmail(p.email);
  var password = typeof p.password === 'string' ? p.password : '';
  // Throttle by email across requests (in addition to the per-account lockout).
  var cache = CacheService.getScriptCache();
  var throttleKey = 'login:' + sha256Hex(email).slice(0, 32);
  var attempts = Number(cache.get(throttleKey) || 0);
  if (attempts >= 20) fail('RATE_LIMITED', 'Too many sign-in attempts. Try again later.');
  cache.put(throttleKey, String(attempts + 1), 900);

  return withLock(function () {
    var user = userByEmail(email);
    var genericError = function () { fail('INVALID_CREDENTIALS', 'Incorrect email or password.'); };
    if (!user) {
      hashPassword(password || 'x', '00000000000000000000000000000000'); // equalize timing
      genericError();
    }
    if (user.locked_until && Date.parse(user.locked_until) > Date.now()) {
      fail('ACCOUNT_LOCKED', 'Too many failed attempts. Try again after ' + user.locked_until + '.');
    }
    if (!verifyPassword(password, user)) {
      var failed = (Number(user.failed_logins) || 0) + 1;
      var patch = { failed_logins: failed };
      if (failed >= LIMITS.maxFailedLogins) {
        patch.locked_until = new Date(Date.now() + LIMITS.lockMinutes * 60000).toISOString();
        patch.failed_logins = 0;
      }
      Db.update('users', user, patch, ['failed_logins', 'locked_until']);
      writeAudit({ actor_id: user.id, action: 'auth.login_failed', entity_type: 'user', entity_id: user.id, details: { locked: !!patch.locked_until } });
      genericError();
    }
    if (user.active !== 'TRUE' || ROLES.indexOf(user.role) < 0) fail('ACCOUNT_DISABLED', 'This account is disabled. Contact an administrator.');
    Db.update('users', user, { failed_logins: 0, locked_until: '' }, ['failed_logins', 'locked_until']);
    var s = createSession(user, p.user_agent);
    writeAudit({ actor_id: user.id, action: 'auth.login', entity_type: 'user', entity_id: user.id, details: {} });
    return { token: s.token, expires_at: s.expires_at, user: publicUser(user) };
  });
}

function actionLogout(p, ctx) {
  return withLock(function () {
    var auth = authenticate(p.token);
    var session = Db.find('sessions', function (r) { return r.token_hash === auth.session.token_hash; });
    Db.update('sessions', session, { revoked_at: nowIso() }, ['revoked_at']);
    return { signed_out: true };
  });
}

function actionMe(p, ctx) {
  return { user: publicUser(ctx.user) };
}

function actionChangePassword(p, ctx) {
  validateNewPassword(p.new_password);
  return withLock(function () {
    var user = userById(ctx.user.id);
    if (!verifyPassword(String(p.current_password || ''), user)) fail('INVALID_CREDENTIALS', 'Current password is incorrect.');
    var h = hashPassword(p.new_password);
    Db.update('users', user, {
      password_hash: h.hash, password_salt: h.salt, password_iterations: h.iterations,
      must_change_password: 'FALSE', password_changed_at: nowIso(), updated_at: nowIso()
    }, ['password_hash', 'password_salt', 'password_iterations', 'must_change_password', 'password_changed_at', 'updated_at']);
    revokeOtherSessions(user.id, ctx.session.token_hash);
    writeAudit({ actor_id: user.id, action: 'auth.password_changed', entity_type: 'user', entity_id: user.id, details: {} });
    return { changed: true };
  });
}

function revokeOtherSessions(userId, keepTokenHash) {
  Db.filter('sessions', function (r) {
    return r.user_id === userId && !r.revoked_at && r.token_hash !== keepTokenHash;
  }).forEach(function (s) {
    Db.update('sessions', s, { revoked_at: nowIso() }, ['revoked_at']);
  });
}

/**
 * Always responds the same way whether or not the email exists, so the
 * endpoint cannot be used to enumerate accounts.
 */
function actionRequestPasswordReset(p, ctx) {
  var email = normalizeEmail(p.email);
  var cache = CacheService.getScriptCache();
  var key = 'reset:' + sha256Hex(email).slice(0, 32);
  if (cache.get(key)) return { requested: true };
  cache.put(key, '1', 120);
  withLock(function () {
    var user = userByEmail(email);
    if (!user || user.active !== 'TRUE') return;
    var code = String(parseInt(randomToken().slice(0, 12), 16) % 1000000);
    while (code.length < 6) code = '0' + code;
    var now = new Date();
    Db.insert('password_resets', [{
      id: newId(), code_hash: sha256Hex(user.id + ':' + code), user_id: user.id,
      created_at: now.toISOString(),
      expires_at: new Date(now.getTime() + LIMITS.resetCodeMinutes * 60000).toISOString(), used_at: ''
    }]);
    MailApp.sendEmail({
      to: user.email,
      subject: 'Road Repair Tracker — รหัสรีเซ็ตรหัสผ่าน / Password reset code',
      body: 'รหัสรีเซ็ตรหัสผ่านของคุณคือ / Your reset code is: ' + code + '\n\n' +
        'รหัสนี้ใช้ได้ ' + LIMITS.resetCodeMinutes + ' นาที / Valid for ' + LIMITS.resetCodeMinutes + ' minutes.\n' +
        'หากคุณไม่ได้ร้องขอ โปรดละเว้นอีเมลนี้ / If you did not request this, ignore this email.'
    });
    writeAudit({ actor_id: user.id, action: 'auth.password_reset_requested', entity_type: 'user', entity_id: user.id, details: {} });
  });
  return { requested: true };
}

function actionResetPassword(p, ctx) {
  var email = normalizeEmail(p.email);
  var code = String(p.code || '').trim();
  validateNewPassword(p.new_password);
  return withLock(function () {
    var user = userByEmail(email);
    var invalid = function () { fail('INVALID_RESET_CODE', 'The reset code is invalid or has expired.'); };
    if (!user || !/^\d{6}$/.test(code)) invalid();
    var hash = sha256Hex(user.id + ':' + code);
    var reset = Db.find('password_resets', function (r) {
      return r.user_id === user.id && !r.used_at && Date.parse(r.expires_at) > Date.now() && safeEqual(r.code_hash, hash);
    });
    if (!reset) {
      var failed = (Number(user.failed_logins) || 0) + 1;
      Db.update('users', user, { failed_logins: failed }, ['failed_logins']);
      if (failed >= LIMITS.maxFailedLogins) {
        // Burn all outstanding codes after repeated guesses.
        Db.filter('password_resets', function (r) { return r.user_id === user.id && !r.used_at; }).forEach(function (r) {
          Db.update('password_resets', r, { used_at: nowIso() }, ['used_at']);
        });
        Db.update('users', user, { failed_logins: 0 }, ['failed_logins']);
      }
      invalid();
    }
    Db.update('password_resets', reset, { used_at: nowIso() }, ['used_at']);
    var h = hashPassword(p.new_password);
    Db.update('users', user, {
      password_hash: h.hash, password_salt: h.salt, password_iterations: h.iterations,
      must_change_password: 'FALSE', failed_logins: 0, locked_until: '', password_changed_at: nowIso(), updated_at: nowIso()
    }, ['password_hash', 'password_salt', 'password_iterations', 'must_change_password', 'failed_logins', 'locked_until', 'password_changed_at', 'updated_at']);
    revokeOtherSessions(user.id, null);
    writeAudit({ actor_id: user.id, action: 'auth.password_reset', entity_type: 'user', entity_id: user.id, details: {} });
    return { reset: true };
  });
}

/* ===== 05_Audit.js ===== */
/**
 * Append-only, hash-chained audit log. Each row's hash covers the previous
 * row's hash, so editing or deleting a row directly in the spreadsheet is
 * detectable with actionVerifyAuditChain. (It cannot stop the spreadsheet
 * owner from rewriting the whole chain — see docs/LIMITATIONS.)
 */
function auditRowHash(row) {
  return sha256Hex([
    row.prev_hash, row.id, row.created_at, row.actor_id, row.repair_job_id, row.action,
    row.entity_type, row.entity_id, row.details
  ].map(normalizedCell).join('|'));
}

function writeAudit(entry) {
  var rows = Db.all('audit_logs');
  var prev = rows.length ? rows[rows.length - 1].row_hash : 'GENESIS';
  var row = {
    id: newId(),
    created_at: nowIso(),
    actor_id: entry.actor_id || '',
    repair_job_id: entry.repair_job_id || '',
    action: entry.action,
    entity_type: entry.entity_type || '',
    entity_id: entry.entity_id || '',
    details: JSON.stringify(entry.details || {}),
    prev_hash: prev
  };
  row.row_hash = auditRowHash(row);
  Db.insert('audit_logs', [row]);
  return row;
}

function publicAudit(r) {
  return {
    id: r.id, created_at: r.created_at, actor_id: r.actor_id || null, repair_job_id: r.repair_job_id || null,
    action: r.action, entity_type: r.entity_type, entity_id: r.entity_id || null, details: parseJsonSafe(r.details, {})
  };
}

/* ===== 06_Jobs.js ===== */
/* ---------------------------------------------------------- permissions */

function canViewJob(user, job) {
  if (!job) return false;
  if (user.role === 'admin' || user.role === 'reviewer') return true;
  return user.role === 'inspector' && (job.assigned_to === user.id || job.created_by === user.id);
}

/** Capture / mark-repaired / edit: the assigned inspector, or an admin. */
function canWorkOnJob(user, job) {
  if (!job) return false;
  if (user.role === 'admin') return true;
  return user.role === 'inspector' && job.assigned_to === user.id;
}

function loadJobForUser(user, jobId) {
  if (!isUuid(jobId)) fail('VALIDATION_ERROR', 'Invalid job id');
  var job = Db.byId('repair_jobs', jobId);
  // Same error for "missing" and "not allowed" so job ids cannot be probed.
  if (!job || !canViewJob(user, job)) fail('NOT_FOUND', 'Repair job not found.');
  return job;
}

function isTerminal(status) {
  return status === JOB_STATUS.APPROVED || status === JOB_STATUS.CANCELLED;
}

/** The only place a job status changes. Enforces JOB_TRANSITIONS. */
function transitionJob(job, to, actorId, reason, extraPatch) {
  var from = job.status;
  var allowed = JOB_TRANSITIONS[from] || [];
  if (allowed.indexOf(to) < 0) fail('INVALID_TRANSITION', 'Cannot change status from ' + from + ' to ' + to + '.', { from: from, to: to });
  var patch = extraPatch || {};
  patch.status = to;
  patch.updated_at = nowIso();
  Db.update('repair_jobs', job, patch, Object.keys(patch));
  writeAudit({
    actor_id: actorId, repair_job_id: job.id, action: 'job.status_changed', entity_type: 'repair_job', entity_id: job.id,
    details: { from: from, to: to, reason: reason || null }
  });
  return job;
}

function nextJobCode() {
  var year = new Date().getUTCFullYear();
  var key = 'job_code:' + year;
  var row = Db.find('counters', function (r) { return r.key === key; });
  var value;
  if (row) {
    value = (Number(row.value) || 0) + 1;
    Db.update('counters', row, { value: value }, ['value']);
  } else {
    value = 1;
    Db.insert('counters', [{ key: key, value: value }]);
  }
  var n = String(value);
  while (n.length < 6) n = '0' + n;
  var code = 'RR-' + year + '-' + n;
  if (Db.find('repair_jobs', function (r) { return r.job_code === code; })) fail('CONFLICT', 'Job code collision, please retry.');
  return code;
}

/* ---------------------------------------------------------- projections */

function userNameMap() {
  var m = {};
  Db.all('users').forEach(function (u) { m[u.id] = { id: u.id, full_name: u.full_name, email: u.email, role: u.role }; });
  return m;
}

function publicJob(j, names) {
  names = names || {};
  return {
    id: j.id, job_code: j.job_code, road_name: j.road_name, location_description: j.location_description,
    damage_type: j.damage_type, description: j.description, priority: j.priority, notes: j.notes, status: j.status,
    assigned_to: j.assigned_to || null, assigned_to_name: names[j.assigned_to] ? names[j.assigned_to].full_name : null,
    created_by: j.created_by, created_by_name: names[j.created_by] ? names[j.created_by].full_name : null,
    created_at: j.created_at, updated_at: j.updated_at, completed_at: j.completed_at || null,
    cancel_reason: j.cancel_reason || null,
    current_before_photo_id: j.current_before_photo_id || null,
    current_after_photo_id: j.current_after_photo_id || null,
    current_verification_id: j.current_verification_id || null,
    after_attempts: Number(j.after_attempts) || 0,
    planned_latitude: cellNumber(j.planned_latitude), planned_longitude: cellNumber(j.planned_longitude),
    planned_accuracy_m: cellNumber(j.planned_accuracy_m)
  };
}

function publicPhoto(p, names) {
  names = names || {};
  return {
    id: p.id, repair_job_id: p.repair_job_id, capture_type: p.capture_type, attempt_number: Number(p.attempt_number) || 1,
    status: p.status, status_reason: p.status_reason || null, storage_path: p.storage_path, sha256_hash: p.sha256_hash,
    mime_type: p.mime_type, file_size_bytes: cellNumber(p.file_size_bytes), captured_at: p.captured_at,
    location_fix_at: p.location_fix_at || null, latitude: cellNumber(p.latitude), longitude: cellNumber(p.longitude),
    gps_accuracy_m: cellNumber(p.gps_accuracy_m), heading_degrees: cellNumber(p.heading_degrees),
    heading_source: p.heading_source || null, heading_measured_at: p.heading_measured_at || null,
    heading_uncertainty_deg: cellNumber(p.heading_uncertainty_deg), capture_method: p.capture_method,
    captured_by: p.captured_by, captured_by_name: names[p.captured_by] ? names[p.captured_by].full_name : null,
    device_metadata: parseJsonSafe(p.device_metadata, {}), received_at: p.received_at,
    record_intact: p.record_hash === recordHash('repair_photos', p)
  };
}

function publicVerification(v, names) {
  names = names || {};
  return {
    id: v.id, repair_job_id: v.repair_job_id, before_photo_id: v.before_photo_id, after_photo_id: v.after_photo_id,
    attempt_number: Number(v.attempt_number) || 1,
    measured_distance_m: cellNumber(v.measured_distance_m), before_accuracy_m: cellNumber(v.before_accuracy_m),
    after_accuracy_m: cellNumber(v.after_accuracy_m), heading_difference_degrees: cellNumber(v.heading_difference_degrees),
    gps_accuracy_pass: cellBool(v.gps_accuracy_pass), distance_pass: cellBool(v.distance_pass), heading_pass: cellBool(v.heading_pass),
    overall_status: v.overall_status, failure_reasons: parseJsonSafe(v.failure_reasons, []), rules_version: v.rules_version,
    thresholds: parseJsonSafe(v.thresholds, {}), verified_at: v.verified_at, verified_by: v.verified_by || null,
    record_intact: v.record_hash === recordHash('verification_results', v)
  };
}

function publicReview(r, names) {
  names = names || {};
  return {
    id: r.id, repair_job_id: r.repair_job_id, verification_id: r.verification_id, after_photo_id: r.after_photo_id,
    decision: r.decision, reason: r.reason, reviewer_id: r.reviewer_id,
    reviewer_name: names[r.reviewer_id] ? names[r.reviewer_id].full_name : null, created_at: r.created_at,
    record_intact: r.record_hash === recordHash('repair_reviews', r)
  };
}

/* ---------------------------------------------------------------- actions */

function readJobFields(p, partial) {
  var out = {};
  var spec = {
    road_name: { max: LIMITS.maxShortTextLength },
    location_description: { max: LIMITS.maxTextLength, optional: true },
    damage_type: { oneOf: DAMAGE_TYPES },
    description: { max: LIMITS.maxTextLength, optional: true },
    priority: { oneOf: PRIORITIES },
    notes: { max: LIMITS.maxTextLength, optional: true }
  };
  Object.keys(spec).forEach(function (k) {
    if (partial && !(k in p)) return;
    out[k] = reqString(p, k, spec[k]);
  });
  return out;
}

function actionCreateJob(p, ctx) {
  requireRole(ctx.user, ['admin', 'inspector']);
  var fields = readJobFields(p, false);
  var assignedTo = ctx.user.id;
  if (p.assigned_to && p.assigned_to !== ctx.user.id) {
    if (ctx.user.role !== 'admin') fail('FORBIDDEN', 'Only an administrator can assign a job to someone else.');
    assignedTo = p.assigned_to;
  }
  var lat = optNumber(p, 'planned_latitude');
  var lng = optNumber(p, 'planned_longitude');
  var acc = optNumber(p, 'planned_accuracy_m');
  if ((lat !== null && (lat < -90 || lat > 90)) || (lng !== null && (lng < -180 || lng > 180)) || (acc !== null && acc <= 0)) {
    fail('VALIDATION_ERROR', 'Invalid planned location');
  }
  return withLock(function () {
    if (ctx.user.role === 'admin' && assignedTo !== ctx.user.id) {
      var assignee = userById(assignedTo);
      if (!assignee || assignee.role !== 'inspector' || assignee.active !== 'TRUE') fail('VALIDATION_ERROR', 'Assigned user must be an active inspector.');
    }
    var now = nowIso();
    var job = {
      id: newId(), job_code: nextJobCode(), status: JOB_STATUS.DRAFT, assigned_to: assignedTo, created_by: ctx.user.id,
      created_at: now, updated_at: now, completed_at: '', cancel_reason: '', current_before_photo_id: '',
      current_after_photo_id: '', current_verification_id: '', after_attempts: 0,
      planned_latitude: lat, planned_longitude: lng, planned_accuracy_m: acc
    };
    Object.keys(fields).forEach(function (k) { job[k] = fields[k]; });
    var stored = Db.insert('repair_jobs', [job])[0];
    writeAudit({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'job.created', entity_type: 'repair_job', entity_id: job.id, details: { job_code: job.job_code } });
    return { job: publicJob(stored, userNameMap()) };
  });
}

function actionUpdateJob(p, ctx) {
  var fields = readJobFields(p, true);
  return withLock(function () {
    var job = loadJobForUser(ctx.user, p.id);
    if (!canWorkOnJob(ctx.user, job)) fail('FORBIDDEN', 'You cannot edit this job.');
    if (isTerminal(job.status)) fail('INVALID_STATE', 'A closed job cannot be edited.');
    var before = {};
    Object.keys(fields).forEach(function (k) { before[k] = job[k]; });
    fields.updated_at = nowIso();
    Db.update('repair_jobs', job, fields, Object.keys(fields));
    writeAudit({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'job.updated', entity_type: 'repair_job', entity_id: job.id, details: { before: before } });
    return { job: publicJob(job, userNameMap()) };
  });
}

function actionMarkRepairDone(p, ctx) {
  return withLock(function () {
    var job = loadJobForUser(ctx.user, p.id);
    if (!canWorkOnJob(ctx.user, job)) fail('FORBIDDEN', 'Only the assigned inspector can update this job.');
    if (job.status !== JOB_STATUS.AWAITING_REPAIR) fail('INVALID_STATE', 'Job is not awaiting repair.');
    transitionJob(job, JOB_STATUS.AWAITING_AFTER_PHOTO, ctx.user.id, reqString(p, 'note', { optional: true, max: LIMITS.maxTextLength }) || null);
    return { job: publicJob(job, userNameMap()) };
  });
}

function actionCancelJob(p, ctx) {
  var reason = reqString(p, 'reason', { min: 3, max: LIMITS.maxTextLength });
  return withLock(function () {
    var job = loadJobForUser(ctx.user, p.id);
    var creatorEarly = ctx.user.role === 'inspector' && job.created_by === ctx.user.id &&
      (job.status === JOB_STATUS.DRAFT || job.status === JOB_STATUS.AWAITING_REPAIR);
    if (ctx.user.role !== 'admin' && !creatorEarly) fail('FORBIDDEN', 'You cannot cancel this job.');
    transitionJob(job, JOB_STATUS.CANCELLED, ctx.user.id, reason, { cancel_reason: reason });
    return { job: publicJob(job, userNameMap()) };
  });
}

function actionAssignJob(p, ctx) {
  requireRole(ctx.user, ['admin']);
  return withLock(function () {
    var job = loadJobForUser(ctx.user, p.id);
    if (isTerminal(job.status)) fail('INVALID_STATE', 'A closed job cannot be reassigned.');
    var assignee = userById(p.assigned_to);
    if (!assignee || assignee.role !== 'inspector' || assignee.active !== 'TRUE') fail('VALIDATION_ERROR', 'Assigned user must be an active inspector.');
    var from = job.assigned_to;
    Db.update('repair_jobs', job, { assigned_to: assignee.id, updated_at: nowIso() }, ['assigned_to', 'updated_at']);
    writeAudit({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'job.assigned', entity_type: 'repair_job', entity_id: job.id, details: { from: from, to: assignee.id } });
    return { job: publicJob(job, userNameMap()) };
  });
}

function visibleJobs(user) {
  return Db.filter('repair_jobs', function (j) { return canViewJob(user, j); });
}

function actionListJobs(p, ctx) {
  var names = userNameMap();
  var status = p.status ? reqString(p, 'status', { oneOf: Object.keys(JOB_STATUS) }) : '';
  var q = p.q ? reqString(p, 'q', { max: 100 }).toLowerCase() : '';
  var from = p.date_from ? Date.parse(p.date_from) : null;
  var to = p.date_to ? Date.parse(p.date_to) : null;
  var photos = {};
  Db.all('repair_photos').forEach(function (ph) { photos[ph.id] = ph; });
  var verifications = {};
  Db.all('verification_results').forEach(function (v) { verifications[v.id] = v; });

  var jobs = visibleJobs(ctx.user).filter(function (j) {
    if (status && j.status !== status) return false;
    if (q && [j.job_code, j.road_name, j.location_description].join(' ').toLowerCase().indexOf(q) < 0) return false;
    var created = Date.parse(j.created_at);
    if (from !== null && isFinite(from) && created < from) return false;
    if (to !== null && isFinite(to) && created > to) return false;
    return true;
  });
  jobs.sort(function (a, b) { return a.created_at < b.created_at ? 1 : -1; });
  var limit = Math.min(Number(p.limit) || 500, 1000);
  return {
    total: jobs.length,
    jobs: jobs.slice(0, limit).map(function (j) {
      var out = publicJob(j, names);
      var before = photos[j.current_before_photo_id];
      out.before = before ? { id: before.id, latitude: cellNumber(before.latitude), longitude: cellNumber(before.longitude), captured_at: before.captured_at } : null;
      var v = verifications[j.current_verification_id];
      out.verification_status = v ? v.overall_status : 'PENDING';
      return out;
    })
  };
}

function actionGetJob(p, ctx) {
  var job = loadJobForUser(ctx.user, p.id);
  var names = userNameMap();
  var byJob = function (r) { return r.repair_job_id === job.id; };
  var audit = (ctx.user.role === 'admin' || ctx.user.role === 'reviewer' || canViewJob(ctx.user, job))
    ? Db.filter('audit_logs', byJob).map(publicAudit) : [];
  return {
    job: publicJob(job, names),
    photos: Db.filter('repair_photos', byJob).map(function (x) { return publicPhoto(x, names); }),
    verifications: Db.filter('verification_results', byJob).map(function (x) { return publicVerification(x, names); }),
    reviews: Db.filter('repair_reviews', byJob).map(function (x) { return publicReview(x, names); }),
    corrections: Db.filter('evidence_corrections', byJob).map(function (c) {
      return { id: c.id, repair_photo_id: c.repair_photo_id, action: c.action, reason: c.reason, details: parseJsonSafe(c.details, {}), actor_id: c.actor_id, actor_name: names[c.actor_id] ? names[c.actor_id].full_name : null, created_at: c.created_at };
    }),
    audit: audit.map(function (a) { a.actor_name = a.actor_id && names[a.actor_id] ? names[a.actor_id].full_name : null; return a; }),
    permissions: {
      can_capture: canWorkOnJob(ctx.user, job),
      can_review: (ctx.user.role === 'reviewer' || ctx.user.role === 'admin') && job.status === JOB_STATUS.PENDING_REVIEW,
      can_cancel: !isTerminal(job.status) && (ctx.user.role === 'admin' ||
        (ctx.user.role === 'inspector' && job.created_by === ctx.user.id && (job.status === 'DRAFT' || job.status === 'AWAITING_REPAIR')))
    }
  };
}

function actionStats(p, ctx) {
  var counts = { total: 0 };
  Object.keys(JOB_STATUS).forEach(function (s) { counts[s] = 0; });
  visibleJobs(ctx.user).forEach(function (j) {
    counts.total++;
    if (counts[j.status] !== undefined) counts[j.status]++;
  });
  return { counts: counts };
}

/** Everything a report needs in one call: jobs + current evidence + verification + latest review. */
function actionReportData(p, ctx) {
  var names = userNameMap();
  var listed = actionListJobs(p, ctx).jobs;
  var only = p.job_id ? String(p.job_id) : '';
  var photos = {};
  Db.all('repair_photos').forEach(function (ph) { photos[ph.id] = ph; });
  var verifications = {};
  Db.all('verification_results').forEach(function (v) { verifications[v.id] = v; });
  var reviewsByJob = {};
  Db.all('repair_reviews').forEach(function (r) { reviewsByJob[r.repair_job_id] = r; }); // rows are chronological: last wins
  return {
    generated_at: nowIso(),
    rows: listed.filter(function (j) { return !only || j.id === only; }).map(function (j) {
      var before = photos[j.current_before_photo_id];
      var after = photos[j.current_after_photo_id];
      var v = verifications[j.current_verification_id];
      var r = reviewsByJob[j.id];
      return {
        job: j,
        before: before ? publicPhoto(before, names) : null,
        after: after ? publicPhoto(after, names) : null,
        verification: v ? publicVerification(v, names) : null,
        review: r ? publicReview(r, names) : null
      };
    })
  };
}

/* ===== 07_Capture.js ===== */
var LIVE_CAPTURE_METHODS = ['image_capture_api', 'video_frame_canvas'];

/** Detect the real image type from magic bytes (never trust the client's MIME). */
function detectImageMime(bytes) {
  var b = function (i) { return bytes[i] & 0xff; };
  if (bytes.length > 3 && b(0) === 0xff && b(1) === 0xd8 && b(2) === 0xff) return 'image/jpeg';
  if (bytes.length > 8 && b(0) === 0x89 && b(1) === 0x50 && b(2) === 0x4e && b(3) === 0x47) return 'image/png';
  if (bytes.length > 12 && b(0) === 0x52 && b(1) === 0x49 && b(2) === 0x46 && b(3) === 0x46 &&
      b(8) === 0x57 && b(9) === 0x45 && b(10) === 0x42 && b(11) === 0x50) return 'image/webp';
  return null;
}

function extensionFor(mime) {
  return mime === 'image/png' ? 'png' : mime === 'image/webp' ? 'webp' : 'jpg';
}

function readMeasurement(m) {
  if (!m || typeof m !== 'object') fail('VALIDATION_ERROR', 'measurement is required');
  return {
    latitude: optNumber(m, 'latitude'),
    longitude: optNumber(m, 'longitude'),
    accuracyM: optNumber(m, 'accuracy_m'),
    headingDeg: optNumber(m, 'heading_deg'),
    headingSource: m.heading_source ? reqString(m, 'heading_source', { max: 64 }) : null,
    headingUncertaintyDeg: optNumber(m, 'heading_uncertainty_deg'),
    capturedAt: optTimestamp(m, 'captured_at'),
    locationFixAt: optTimestamp(m, 'location_fix_at'),
    headingMeasuredAt: optTimestamp(m, 'heading_measured_at')
  };
}

function measurementFromPhoto(row) {
  return {
    latitude: cellNumber(row.latitude),
    longitude: cellNumber(row.longitude),
    accuracyM: cellNumber(row.gps_accuracy_m),
    headingDeg: cellNumber(row.heading_degrees),
    headingSource: row.heading_source || null,
    headingUncertaintyDeg: cellNumber(row.heading_uncertainty_deg),
    capturedAt: row.captured_at || null,
    locationFixAt: row.location_fix_at || null,
    headingMeasuredAt: row.heading_measured_at || null
  };
}

function activePhoto(jobId, captureType) {
  return Db.find('repair_photos', function (r) {
    return r.repair_job_id === jobId && r.capture_type === captureType && r.status === 'ACTIVE';
  });
}

function evidenceFolderForJob(job) {
  var rootId = PropertiesService.getScriptProperties().getProperty('EVIDENCE_FOLDER_ID');
  if (!rootId) fail('NOT_CONFIGURED', 'Evidence folder is not configured. Run setup() first.');
  var root = DriveApp.getFolderById(rootId);
  var it = root.getFoldersByName(job.id);
  return it.hasNext() ? it.next() : root.createFolder(job.id);
}

function replayResult(existing, p, ctx, clientHash) {
  if (existing.repair_job_id !== p.job_id || existing.capture_type !== p.capture_type || existing.sha256_hash !== clientHash) {
    fail('CONFLICT', 'photo_id was already used for different evidence.');
  }
  var names = userNameMap();
  var v = Db.find('verification_results', function (r) { return r.after_photo_id === existing.id; });
  return {
    idempotent_replay: true,
    photo: publicPhoto(existing, names),
    verification: v ? publicVerification(v, names) : null,
    job: publicJob(Db.byId('repair_jobs', existing.repair_job_id), names)
  };
}

/**
 * Authoritative capture submission. The photo_id generated by the client is
 * the idempotency key: retries and double taps return the stored result and
 * never create a second photo or verification.
 */
function actionSubmitCapture(p, ctx) {
  requireRole(ctx.user, ['admin', 'inspector']);
  var captureType = reqString(p, 'capture_type', { oneOf: CAPTURE_TYPES });
  if (!isUuid(p.photo_id)) fail('VALIDATION_ERROR', 'photo_id must be a UUID');
  if (!isUuid(p.job_id)) fail('VALIDATION_ERROR', 'job_id must be a UUID');
  var clientHash = reqString(p, 'client_sha256', { max: 64 }).toLowerCase();
  if (!/^[0-9a-f]{64}$/.test(clientHash)) fail('VALIDATION_ERROR', 'client_sha256 must be a SHA-256 hex digest');
  var captureMethod = reqString(p, 'capture_method', { oneOf: LIVE_CAPTURE_METHODS });
  var declaredMime = reqString(p, 'mime_type', { oneOf: ['image/jpeg', 'image/png', 'image/webp'] });
  var measurement = readMeasurement(p.measurement);
  if (typeof p.image_base64 !== 'string' || p.image_base64.length === 0) fail('VALIDATION_ERROR', 'image_base64 is required');
  if (p.image_base64.length * 3 / 4 > LIMITS.maxImageBytes + 4) fail('FILE_TOO_LARGE', 'Image exceeds ' + LIMITS.maxImageBytes + ' bytes.');
  var deviceMetadata = p.device_metadata && typeof p.device_metadata === 'object' ? p.device_metadata : {};
  var deviceJson = JSON.stringify(deviceMetadata);
  if (deviceJson.length > 4000) fail('VALIDATION_ERROR', 'device_metadata is too large');

  return withLock(function () {
    var existing = Db.byId('repair_photos', p.photo_id);
    if (existing) return replayResult(existing, p, ctx, clientHash);

    var job = loadJobForUser(ctx.user, p.job_id);
    if (!canWorkOnJob(ctx.user, job)) fail('FORBIDDEN', 'Only the assigned inspector can capture evidence for this job.');

    var before = activePhoto(job.id, 'BEFORE');
    if (captureType === 'BEFORE') {
      if (before) fail('DUPLICATE_BEFORE', 'This job already has active Before evidence.');
      if (job.status !== JOB_STATUS.DRAFT) fail('INVALID_STATE', 'Before evidence can only be added to a draft job.');
    } else {
      if (!before) fail('BEFORE_REQUIRED', 'A valid Before photo must exist before an After photo.');
      if (AFTER_CAPTURE_STATUSES.indexOf(job.status) < 0) fail('INVALID_STATE', 'Job status ' + job.status + ' does not accept an After photo.');
    }

    // --- File integrity (server-computed hash is authoritative) -------------
    var bytes;
    try {
      bytes = Utilities.base64Decode(p.image_base64);
    } catch (e) {
      fail('VALIDATION_ERROR', 'image_base64 is not valid base64');
    }
    if (bytes.length === 0 || bytes.length > LIMITS.maxImageBytes) fail('FILE_TOO_LARGE', 'Image size is invalid.');
    var realMime = detectImageMime(bytes);
    if (!realMime) fail('INVALID_IMAGE', 'File is not a supported image.');
    if (realMime !== declaredMime) fail('INVALID_IMAGE', 'Declared MIME type does not match the file content.');
    var serverHash = sha256HexBytes(bytes);
    if (serverHash !== clientHash) fail('HASH_MISMATCH', 'Uploaded file does not match its SHA-256 hash. Please retry the upload.');

    // --- Submission timing (not part of the pass/fail verification) ----------
    var receivedAt = new Date();
    var capturedMs = measurement.capturedAt ? Date.parse(measurement.capturedAt) : NaN;
    if (!isFinite(capturedMs)) fail('VALIDATION_ERROR', 'measurement.captured_at is required');
    if (capturedMs - receivedAt.getTime() > RRVerify.SUBMISSION_LIMITS.maxClockSkewMs) fail('CLOCK_SKEW', 'Capture time is in the future. Check the device clock.');
    if (receivedAt.getTime() - capturedMs > RRVerify.SUBMISSION_LIMITS.maxSubmissionDelayMs) fail('CAPTURE_TOO_OLD', 'This capture is too old to submit. Please capture again.');

    var rules = RRVerify.CURRENT_RULES;
    var outcome = null;
    if (captureType === 'BEFORE') {
      var evaluation = RRVerify.evaluateCapture(measurement, 'BEFORE', rules);
      if (!RRVerify.isCaptureAcceptable(evaluation)) {
        fail('CAPTURE_REJECTED', 'Before capture does not meet the requirements.', { reasons: evaluation.reasons, rules_version: rules.version });
      }
    } else {
      outcome = RRVerify.verifyCapturePair(measurementFromPhoto(before), measurement, rules);
    }

    // --- Persist: Drive file, then rows, then job status ----------------------
    var attempt = captureType === 'AFTER' ? (Number(job.after_attempts) || 0) + 1 : 1;
    var ext = extensionFor(realMime);
    var storagePath = job.id + '/' + captureType + '/' + p.photo_id + '.' + ext;
    var folder = evidenceFolderForJob(job);
    var file = folder.createFile(Utilities.newBlob(bytes, realMime, captureType + '_' + p.photo_id + '.' + ext));
    try {
      file.setDescription('Road Repair evidence ' + job.job_code + ' ' + captureType + ' sha256=' + serverHash);
      var now = receivedAt.toISOString();
      var photo = {
        id: p.photo_id, repair_job_id: job.id, capture_type: captureType, attempt_number: attempt, status: 'ACTIVE',
        status_reason: '', drive_file_id: file.getId(), storage_path: storagePath, sha256_hash: serverHash,
        mime_type: realMime, file_size_bytes: bytes.length, captured_at: measurement.capturedAt,
        location_fix_at: measurement.locationFixAt, latitude: measurement.latitude, longitude: measurement.longitude,
        gps_accuracy_m: measurement.accuracyM, heading_degrees: measurement.headingDeg,
        heading_source: measurement.headingSource, heading_measured_at: measurement.headingMeasuredAt,
        heading_uncertainty_deg: measurement.headingUncertaintyDeg, capture_method: captureMethod,
        captured_by: ctx.user.id, device_metadata: deviceJson, received_at: now
      };
      photo.record_hash = recordHash('repair_photos', photo);

      var storedPhoto = Db.insert('repair_photos', [photo])[0];
      writeAudit({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'photo.captured', entity_type: 'repair_photo', entity_id: photo.id,
        details: { capture_type: captureType, sha256: serverHash, attempt: attempt } });

      if (captureType === 'AFTER') {
        // Keep earlier attempts as history; only the newest is ACTIVE.
        Db.filter('repair_photos', function (r) {
          return r.repair_job_id === job.id && r.capture_type === 'AFTER' && r.status === 'ACTIVE' && r.id !== photo.id;
        }).forEach(function (old) {
          Db.update('repair_photos', old, { status: 'SUPERSEDED', status_reason: 'Superseded by attempt ' + attempt }, ['status', 'status_reason']);
          writeAudit({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'photo.superseded', entity_type: 'repair_photo', entity_id: old.id, details: { by: photo.id } });
        });
      }

      var storedVerification = null;
      if (captureType === 'BEFORE') {
        transitionJob(job, JOB_STATUS.AWAITING_REPAIR, ctx.user.id, 'Before evidence captured', { current_before_photo_id: photo.id });
      } else {
        var v = {
          id: newId(), repair_job_id: job.id, before_photo_id: before.id, after_photo_id: photo.id, attempt_number: attempt,
          measured_distance_m: outcome.measuredDistanceM, before_accuracy_m: outcome.beforeAccuracyM,
          after_accuracy_m: outcome.afterAccuracyM, heading_difference_degrees: outcome.headingDifferenceDeg,
          gps_accuracy_pass: outcome.gpsAccuracyPass, distance_pass: outcome.distancePass, heading_pass: outcome.headingPass,
          overall_status: outcome.overallStatus, failure_reasons: JSON.stringify(outcome.reasons),
          rules_version: outcome.rulesVersion, thresholds: JSON.stringify(outcome.thresholds), verified_at: nowIso(),
          verified_by: '' // system-generated check
        };
        v.record_hash = recordHash('verification_results', v);
        storedVerification = Db.insert('verification_results', [v])[0];
        writeAudit({ actor_id: '', repair_job_id: job.id, action: 'verification.recorded', entity_type: 'verification_result', entity_id: v.id,
          details: { overall_status: v.overall_status, rules_version: v.rules_version, after_photo_id: photo.id } });
        var next = outcome.overallStatus === 'PASS' ? JOB_STATUS.PENDING_REVIEW : JOB_STATUS.NEEDS_RECAPTURE;
        transitionJob(job, next, ctx.user.id, 'Verification ' + outcome.overallStatus, {
          current_after_photo_id: photo.id, current_verification_id: v.id, after_attempts: attempt
        });
      }
      var names = userNameMap();
      return {
        idempotent_replay: false,
        photo: publicPhoto(storedPhoto, names),
        verification: storedVerification ? publicVerification(storedVerification, names) : null,
        job: publicJob(job, names)
      };
    } catch (e) {
      // Nothing referencing the file was recorded if we fail before the photo row; trash the orphan.
      if (!Db.byId('repair_photos', p.photo_id)) {
        try { file.setTrashed(true); } catch (ignored) { /* best effort */ }
      }
      throw e;
    }
  });
}

/**
 * Return an evidence image to an authorized user as base64 (the Drive file
 * itself is never shared). `variant: 'thumb'` returns a Drive thumbnail when
 * available, for display only — never as evidence.
 */
function actionGetPhoto(p, ctx) {
  if (!isUuid(p.photo_id)) fail('VALIDATION_ERROR', 'Invalid photo id');
  var photo = Db.byId('repair_photos', p.photo_id);
  if (!photo) fail('NOT_FOUND', 'Photo not found.');
  loadJobForUser(ctx.user, photo.repair_job_id); // throws NOT_FOUND when not permitted
  var file = DriveApp.getFileById(photo.drive_file_id);
  if (p.variant === 'thumb') {
    var thumb = null;
    try { thumb = file.getThumbnail(); } catch (e) { thumb = null; }
    if (thumb) {
      return { photo_id: photo.id, variant: 'thumb', mime_type: thumb.getContentType() || 'image/png', image_base64: Utilities.base64Encode(thumb.getBytes()) };
    }
  }
  var bytes = file.getBlob().getBytes();
  var hash = sha256HexBytes(bytes);
  return {
    photo_id: photo.id, variant: 'original', mime_type: photo.mime_type, sha256_hash: hash,
    integrity_ok: hash === photo.sha256_hash, image_base64: Utilities.base64Encode(bytes)
  };
}

/* ===== 08_Review.js ===== */
var REVIEW_DECISIONS = { APPROVE: 'APPROVED', REJECT: 'REJECTED', REQUEST_RECAPTURE: 'NEEDS_RECAPTURE' };

/**
 * Human acceptance, kept separate from the technical verification. A job can
 * only be APPROVED when its current verification is PASS and the evidence
 * records are intact; the reviewer must give an explicit reason.
 */
function actionReviewJob(p, ctx) {
  requireRole(ctx.user, ['reviewer', 'admin']);
  var decision = reqString(p, 'decision', { oneOf: Object.keys(REVIEW_DECISIONS) });
  var reason = reqString(p, 'reason', { min: 3, max: LIMITS.maxTextLength });
  return withLock(function () {
    var job = loadJobForUser(ctx.user, p.id);
    if (job.status !== JOB_STATUS.PENDING_REVIEW) fail('INVALID_STATE', 'Job is not pending review.');
    var v = Db.byId('verification_results', job.current_verification_id);
    var after = Db.byId('repair_photos', job.current_after_photo_id);
    var before = Db.byId('repair_photos', job.current_before_photo_id);
    if (!v || !after || !before || v.after_photo_id !== after.id || v.before_photo_id !== before.id ||
        after.status !== 'ACTIVE' || before.status !== 'ACTIVE') {
      fail('INVALID_STATE', 'Current evidence is incomplete; it cannot be reviewed.');
    }
    if (decision === 'APPROVE') {
      if (v.overall_status !== 'PASS') fail('VERIFICATION_NOT_PASSED', 'A job whose verification is ' + v.overall_status + ' cannot be approved.');
      if (v.record_hash !== recordHash('verification_results', v) || after.record_hash !== recordHash('repair_photos', after) ||
          before.record_hash !== recordHash('repair_photos', before)) {
        fail('EVIDENCE_TAMPERED', 'Evidence records were modified outside the application. Approval is blocked.');
      }
      var self = after.captured_by === ctx.user.id || before.captured_by === ctx.user.id || job.assigned_to === ctx.user.id;
      if (self && getSetting('allow_self_approval') !== 'true') fail('SELF_APPROVAL_FORBIDDEN', 'You cannot approve a job you captured or are assigned to.');
    }
    var review = {
      id: newId(), repair_job_id: job.id, verification_id: v.id, after_photo_id: after.id, decision: REVIEW_DECISIONS[decision],
      reason: reason, reviewer_id: ctx.user.id, created_at: nowIso()
    };
    review.record_hash = recordHash('repair_reviews', review);
    var stored = Db.insert('repair_reviews', [review])[0];
    writeAudit({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'review.' + decision.toLowerCase(), entity_type: 'repair_review', entity_id: review.id, details: { reason: reason } });
    var extra = decision === 'APPROVE' ? { completed_at: nowIso() } : {};
    transitionJob(job, REVIEW_DECISIONS[decision], ctx.user.id, reason, extra);
    var names = userNameMap();
    return { review: publicReview(stored, names), job: publicJob(job, names) };
  });
}

/* ===== 09_Admin.js ===== */
/* ------------------------------------------------------------- users */

function actionListUsers(p, ctx) {
  requireRole(ctx.user, ['admin']);
  return { users: Db.all('users').map(publicUser) };
}

/** Inspectors list for assignment dropdowns (admin only). */
function actionListInspectors(p, ctx) {
  requireRole(ctx.user, ['admin']);
  return {
    inspectors: Db.filter('users', function (u) { return u.role === 'inspector' && u.active === 'TRUE'; })
      .map(function (u) { return { id: u.id, full_name: u.full_name, email: u.email }; })
  };
}

function insertUser(email, fullName, role, actorId) {
  if (userByEmail(email)) fail('CONFLICT', 'A user with this email already exists.');
  var temp = generateTempPassword();
  var h = hashPassword(temp);
  var now = nowIso();
  var user = {
    id: newId(), email: email, full_name: fullName, role: role, active: 'TRUE', password_hash: h.hash,
    password_salt: h.salt, password_iterations: h.iterations, must_change_password: 'TRUE', failed_logins: 0,
    locked_until: '', password_changed_at: '', created_at: now, updated_at: now
  };
  Db.insert('users', [user]);
  writeAudit({ actor_id: actorId || '', action: 'user.created', entity_type: 'user', entity_id: user.id, details: { email: email, role: role } });
  return { user: user, tempPassword: temp };
}

function actionCreateUser(p, ctx) {
  requireRole(ctx.user, ['admin']);
  var email = normalizeEmail(p.email);
  var fullName = reqString(p, 'full_name', { max: 120 });
  var role = reqString(p, 'role', { oneOf: ROLES });
  return withLock(function () {
    var r = insertUser(email, fullName, role, ctx.user.id);
    // The temporary password is shown once to the admin and must be changed at first sign-in.
    return { user: publicUser(r.user), temporary_password: r.tempPassword };
  });
}

function actionUpdateUser(p, ctx) {
  requireRole(ctx.user, ['admin']);
  return withLock(function () {
    var user = isUuid(p.id) ? userById(p.id) : null;
    if (!user) fail('NOT_FOUND', 'User not found.');
    var patch = {};
    if (p.full_name !== undefined) patch.full_name = reqString(p, 'full_name', { max: 120 });
    if (p.role !== undefined) patch.role = reqString(p, 'role', { oneOf: ROLES });
    if (p.active !== undefined) {
      if (typeof p.active !== 'boolean') fail('VALIDATION_ERROR', 'active must be boolean');
      patch.active = p.active ? 'TRUE' : 'FALSE';
    }
    if (user.id === ctx.user.id && ((patch.role && patch.role !== 'admin') || patch.active === 'FALSE')) {
      fail('FORBIDDEN', 'You cannot remove your own administrator access.');
    }
    var before = { full_name: user.full_name, role: user.role, active: user.active };
    patch.updated_at = nowIso();
    Db.update('users', user, patch, ['full_name', 'role', 'active', 'updated_at']);
    if ((patch.role && patch.role !== before.role) || patch.active === 'FALSE') revokeOtherSessions(user.id, null);
    writeAudit({ actor_id: ctx.user.id, action: 'user.updated', entity_type: 'user', entity_id: user.id, details: { before: before, after: { full_name: user.full_name, role: user.role, active: user.active } } });
    return { user: publicUser(user) };
  });
}

function actionResetUserPassword(p, ctx) {
  requireRole(ctx.user, ['admin']);
  return withLock(function () {
    var user = isUuid(p.id) ? userById(p.id) : null;
    if (!user) fail('NOT_FOUND', 'User not found.');
    var temp = generateTempPassword();
    var h = hashPassword(temp);
    Db.update('users', user, {
      password_hash: h.hash, password_salt: h.salt, password_iterations: h.iterations, must_change_password: 'TRUE',
      failed_logins: 0, locked_until: '', updated_at: nowIso()
    }, ['password_hash', 'password_salt', 'password_iterations', 'must_change_password', 'failed_logins', 'locked_until', 'updated_at']);
    revokeOtherSessions(user.id, null);
    writeAudit({ actor_id: ctx.user.id, action: 'user.password_reset_by_admin', entity_type: 'user', entity_id: user.id, details: {} });
    return { temporary_password: temp };
  });
}

/* ---------------------------------------------------------- settings */

var EDITABLE_SETTINGS = {
  allow_self_approval: function (v) { if (v !== 'true' && v !== 'false') fail('VALIDATION_ERROR', 'allow_self_approval must be true or false'); return v; },
  session_ttl_hours: function (v) { var n = Number(v); if (!(n >= 1 && n <= 72) || Math.floor(n) !== n) fail('VALIDATION_ERROR', 'session_ttl_hours must be 1-72'); return String(n); }
};

function actionGetSettings(p, ctx) {
  var settings = {};
  Object.keys(SETTINGS_DEFAULTS).forEach(function (k) { settings[k] = getSetting(k); });
  return {
    settings: settings,
    // Verification thresholds are fixed per rules version and are not editable at runtime.
    rules: RRVerify.CURRENT_RULES,
    submission_limits: RRVerify.SUBMISSION_LIMITS,
    app_version: APP_VERSION,
    schema_version: SCHEMA_VERSION
  };
}

function actionUpdateSetting(p, ctx) {
  requireRole(ctx.user, ['admin']);
  var key = reqString(p, 'key', { oneOf: Object.keys(EDITABLE_SETTINGS) });
  var value = EDITABLE_SETTINGS[key](String(p.value));
  return withLock(function () {
    var row = Db.find('settings', function (r) { return r.key === key; });
    var old = row ? row.value : SETTINGS_DEFAULTS[key];
    if (row) Db.update('settings', row, { value: value, updated_at: nowIso(), updated_by: ctx.user.id }, ['value', 'updated_at', 'updated_by']);
    else Db.insert('settings', [{ key: key, value: value, updated_at: nowIso(), updated_by: ctx.user.id }]);
    writeAudit({ actor_id: ctx.user.id, action: 'settings.updated', entity_type: 'setting', details: { key: key, from: old, to: value } });
    return { key: key, value: value };
  });
}

/* ------------------------------------------------------------- audit */

function actionListAudit(p, ctx) {
  requireRole(ctx.user, ['admin']);
  var names = userNameMap();
  var rows = Db.all('audit_logs').slice();
  if (p.repair_job_id) rows = rows.filter(function (r) { return r.repair_job_id === p.repair_job_id; });
  if (p.action_prefix) rows = rows.filter(function (r) { return r.action.indexOf(String(p.action_prefix)) === 0; });
  rows.reverse();
  var limit = Math.min(Number(p.limit) || 200, 1000);
  return {
    total: rows.length,
    entries: rows.slice(0, limit).map(function (r) {
      var a = publicAudit(r);
      a.actor_name = a.actor_id && names[a.actor_id] ? names[a.actor_id].full_name : null;
      return a;
    })
  };
}

function actionVerifyAuditChain(p, ctx) {
  requireRole(ctx.user, ['admin']);
  var rows = Db.all('audit_logs');
  var prev = 'GENESIS';
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    if (r.prev_hash !== prev || auditRowHash(r) !== r.row_hash) {
      return { intact: false, checked: i, first_broken_row: r._row, entry_id: r.id };
    }
    prev = r.row_hash;
  }
  return { intact: true, checked: rows.length };
}

/* ---------------------------------------------------------- evidence */

/**
 * Explicit correction process: evidence is never edited or deleted. An admin
 * may INVALIDATE a photo with a reason; the record and the file are kept,
 * the correction is logged, and the job moves to the state that requires new
 * evidence.
 */
function actionInvalidateEvidence(p, ctx) {
  requireRole(ctx.user, ['admin']);
  var reason = reqString(p, 'reason', { min: 5, max: LIMITS.maxTextLength });
  return withLock(function () {
    var photo = isUuid(p.photo_id) ? Db.byId('repair_photos', p.photo_id) : null;
    if (!photo) fail('NOT_FOUND', 'Photo not found.');
    if (photo.status !== 'ACTIVE') fail('INVALID_STATE', 'Only active evidence can be invalidated.');
    var job = Db.byId('repair_jobs', photo.repair_job_id);
    if (isTerminal(job.status)) fail('INVALID_STATE', 'Evidence of a closed job cannot be invalidated.');

    Db.update('repair_photos', photo, { status: 'INVALIDATED', status_reason: reason }, ['status', 'status_reason']);
    Db.insert('evidence_corrections', [{
      id: newId(), repair_photo_id: photo.id, repair_job_id: job.id, action: 'INVALIDATE', reason: reason,
      details: JSON.stringify({ capture_type: photo.capture_type, previous_status: 'ACTIVE' }), actor_id: ctx.user.id, created_at: nowIso()
    }]);
    writeAudit({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'photo.invalidated', entity_type: 'repair_photo', entity_id: photo.id, details: { reason: reason } });

    if (photo.capture_type === 'BEFORE') {
      Db.filter('repair_photos', function (r) { return r.repair_job_id === job.id && r.capture_type === 'AFTER' && r.status === 'ACTIVE'; })
        .forEach(function (a) {
          Db.update('repair_photos', a, { status: 'SUPERSEDED', status_reason: 'Before evidence invalidated' }, ['status', 'status_reason']);
        });
      transitionJob(job, JOB_STATUS.DRAFT, ctx.user.id, reason, { current_before_photo_id: '', current_after_photo_id: '', current_verification_id: '' });
    } else if (job.current_after_photo_id === photo.id) {
      transitionJob(job, JOB_STATUS.NEEDS_RECAPTURE, ctx.user.id, reason, { current_after_photo_id: '', current_verification_id: '' });
    }
    return { job: publicJob(job, userNameMap()) };
  });
}

function actionCheckEvidenceIntegrity(p, ctx) {
  requireRole(ctx.user, ['admin']);
  var job = loadJobForUser(ctx.user, p.id);
  var results = Db.filter('repair_photos', function (r) { return r.repair_job_id === job.id; }).map(function (ph) {
    var fileOk = null;
    try {
      fileOk = sha256HexBytes(DriveApp.getFileById(ph.drive_file_id).getBlob().getBytes()) === ph.sha256_hash;
    } catch (e) {
      fileOk = false;
    }
    return { photo_id: ph.id, capture_type: ph.capture_type, status: ph.status, file_hash_ok: fileOk, record_ok: ph.record_hash === recordHash('repair_photos', ph) };
  });
  var verifications = Db.filter('verification_results', function (r) { return r.repair_job_id === job.id; }).map(function (v) {
    return { verification_id: v.id, record_ok: v.record_hash === recordHash('verification_results', v) };
  });
  writeAuditLocked({ actor_id: ctx.user.id, repair_job_id: job.id, action: 'evidence.integrity_checked', entity_type: 'repair_job', entity_id: job.id,
    details: { all_ok: results.every(function (r) { return r.file_hash_ok && r.record_ok; }) && verifications.every(function (v) { return v.record_ok; }) } });
  return { photos: results, verifications: verifications };
}

function writeAuditLocked(entry) {
  return withLock(function () { return writeAudit(entry); });
}

/* ===== 10_Api.js ===== */
/** Actions callable without a session. */
var PUBLIC_ACTIONS = {
  login: actionLogin,
  requestPasswordReset: actionRequestPasswordReset,
  resetPassword: actionResetPassword,
  logout: actionLogout
};

/** Actions requiring a valid session (role checks happen inside each action). */
var AUTH_ACTIONS = {
  me: actionMe,
  changePassword: actionChangePassword,
  getSettings: actionGetSettings,
  stats: actionStats,
  listJobs: actionListJobs,
  getJob: actionGetJob,
  reportData: actionReportData,
  createJob: actionCreateJob,
  updateJob: actionUpdateJob,
  markRepairDone: actionMarkRepairDone,
  cancelJob: actionCancelJob,
  assignJob: actionAssignJob,
  submitCapture: actionSubmitCapture,
  getPhoto: actionGetPhoto,
  reviewJob: actionReviewJob,
  listUsers: actionListUsers,
  listInspectors: actionListInspectors,
  createUser: actionCreateUser,
  updateUser: actionUpdateUser,
  resetUserPassword: actionResetUserPassword,
  updateSetting: actionUpdateSetting,
  listAudit: actionListAudit,
  verifyAuditChain: actionVerifyAuditChain,
  invalidateEvidence: actionInvalidateEvidence,
  checkEvidenceIntegrity: actionCheckEvidenceIntegrity
};

/** Allowed while the user still has to replace a temporary password. */
var PASSWORD_CHANGE_ALLOWED = ['me', 'changePassword', 'getSettings'];

function jsonOutput(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

/**
 * Single entry point. The browser sends a text/plain POST (no CORS
 * preflight) with a JSON body: { action, token?, payload? }.
 * Apps Script cannot set HTTP status codes, so errors are { ok:false, error }.
 */
function handleRequest(body) {
  Db.reset();
  try {
    if (!body || typeof body !== 'object') fail('BAD_REQUEST', 'Invalid request body.');
    var action = body.action;
    var payload = body.payload && typeof body.payload === 'object' ? body.payload : {};
    if (typeof action !== 'string') fail('BAD_REQUEST', 'Missing action.');
    var data;
    if (Object.prototype.hasOwnProperty.call(PUBLIC_ACTIONS, action)) {
      if (action === 'logout') payload.token = body.token;
      data = PUBLIC_ACTIONS[action](payload, {});
    } else if (Object.prototype.hasOwnProperty.call(AUTH_ACTIONS, action)) {
      var auth = authenticate(body.token);
      if (auth.user.must_change_password === 'TRUE' && PASSWORD_CHANGE_ALLOWED.indexOf(action) < 0) {
        fail('PASSWORD_CHANGE_REQUIRED', 'Please set a new password before continuing.');
      }
      data = AUTH_ACTIONS[action](payload, { user: auth.user, session: auth.session });
    } else {
      fail('UNKNOWN_ACTION', 'Unknown action.');
    }
    return { ok: true, data: data };
  } catch (e) {
    if (e instanceof ApiError) return { ok: false, error: { code: e.code, message: e.message, details: e.details } };
    console.error(e && e.stack ? e.stack : e);
    return { ok: false, error: { code: 'INTERNAL', message: 'Unexpected server error. Please retry.' } };
  }
}

function doPost(e) {
  var body = null;
  try {
    body = JSON.parse(e && e.postData ? e.postData.contents : '');
  } catch (err) {
    return jsonOutput({ ok: false, error: { code: 'BAD_REQUEST', message: 'Body must be JSON.' } });
  }
  return jsonOutput(handleRequest(body));
}

/** Health check only. Never returns data. */
function doGet() {
  return jsonOutput({ ok: true, data: { app: 'road-repair-tracker', version: APP_VERSION, schema: SCHEMA_VERSION, rules: RRVerify.CURRENT_RULES.version } });
}

/* ===== 11_Setup.js ===== */
/**
 * Run once from the Apps Script editor (or the "Road Repair" menu):
 * creates the sheets, headers, protections, default settings and the
 * private Drive folder for original evidence. Safe to run again.
 */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var props = PropertiesService.getScriptProperties();

  Object.keys(SCHEMA).forEach(function (name) {
    var cols = SCHEMA[name].columns;
    var sh = ss.getSheetByName(name) || ss.insertSheet(name);
    var existing = sh.getLastRow() >= 1 ? sh.getRange(1, 1, 1, cols.length).getValues()[0].map(fromCell) : [];
    var hasData = sh.getLastRow() >= 2;
    for (var c = 0; c < cols.length; c++) {
      if (hasData && existing[c] !== cols[c]) {
        throw new Error('Sheet "' + name + '" has data with unexpected headers; refusing to overwrite. Column ' + (c + 1) + ' should be ' + cols[c]);
      }
    }
    sh.getRange(1, 1, 1, cols.length).setValues([cols]);
    // Store every value as plain text so ISO dates / IDs are never auto-converted.
    sh.getRange(1, 1, sh.getMaxRows(), cols.length).setNumberFormat('@');
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, cols.length).setFontWeight('bold').setBackground('#e2e8f0');
    protectSheet(sh);
  });

  // Remove the default empty sheet (e.g. "Sheet1" / "ชีต1").
  ss.getSheets().forEach(function (sh) {
    if (!SCHEMA[sh.getName()] && sh.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(sh);
  });

  Db.reset();
  Object.keys(SETTINGS_DEFAULTS).forEach(function (key) {
    if (!Db.find('settings', function (r) { return r.key === key; })) {
      Db.insert('settings', [{ key: key, value: SETTINGS_DEFAULTS[key], updated_at: nowIso(), updated_by: 'setup' }]);
    }
  });

  var folderId = props.getProperty('EVIDENCE_FOLDER_ID');
  var folder = null;
  if (folderId) {
    try { folder = DriveApp.getFolderById(folderId); } catch (e) { folder = null; }
  }
  if (!folder) {
    folder = DriveApp.createFolder('Road Repair Evidence (private) - ' + ss.getName());
    props.setProperty('EVIDENCE_FOLDER_ID', folder.getId());
  }
  if (Db.all('audit_logs').length === 0) writeAudit({ action: 'system.setup', entity_type: 'system', details: { schema_version: SCHEMA_VERSION } });
  Logger.log('Setup complete. Evidence folder: ' + folder.getUrl());
  return { spreadsheet_id: ss.getId(), evidence_folder_id: folder.getId() };
}

/** Only the owner (the account the web app runs as) may edit the sheets. */
function protectSheet(sh) {
  var protection = sh.protect().setDescription('Road Repair Tracker: edit only through the app');
  var me = Session.getEffectiveUser();
  protection.addEditor(me);
  var editors = protection.getEditors();
  if (editors.length) protection.removeEditors(editors.filter(function (u) { return u.getEmail() !== me.getEmail(); }));
  if (protection.canDomainEdit()) protection.setDomainEdit(false);
}

/** Editor helper: createInitialAdmin('you@example.com', 'Your Name') — prints a one-time password. */
function createInitialAdmin(email, fullName) {
  var result = withLock(function () {
    return insertUser(normalizeEmail(email), String(fullName || 'Administrator').slice(0, 120), 'admin', '');
  });
  Logger.log('Admin created: ' + result.user.email + ' — temporary password: ' + result.tempPassword + ' (must be changed at first sign-in)');
  return { email: result.user.email, temporary_password: result.tempPassword };
}

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Road Repair')
    .addItem('1) ตั้งค่าระบบ / Setup', 'menuSetup')
    .addItem('2) สร้างผู้ดูแลระบบ / Create admin', 'menuCreateAdmin')
    .addItem('ตรวจสอบ audit log chain', 'menuVerifyAudit')
    .addToUi();
}

function menuSetup() {
  var r = setup();
  SpreadsheetApp.getUi().alert('ตั้งค่าเรียบร้อย / Setup complete\nEvidence folder id: ' + r.evidence_folder_id);
}

function menuCreateAdmin() {
  var ui = SpreadsheetApp.getUi();
  var email = ui.prompt('Admin email', ui.ButtonSet.OK_CANCEL);
  if (email.getSelectedButton() !== ui.Button.OK) return;
  var name = ui.prompt('Full name / ชื่อ-นามสกุล', ui.ButtonSet.OK_CANCEL);
  if (name.getSelectedButton() !== ui.Button.OK) return;
  var r = createInitialAdmin(email.getResponseText(), name.getResponseText());
  ui.alert('สร้างผู้ดูแลระบบแล้ว / Admin created\n\nEmail: ' + r.email + '\nรหัสผ่านชั่วคราว / Temporary password: ' + r.temporary_password +
    '\n\nจดไว้ตอนนี้ — จะไม่แสดงอีก / Copy it now; it will not be shown again.');
}

function menuVerifyAudit() {
  Db.reset();
  var r = actionVerifyAuditChain({}, { user: { role: 'admin' } });
  SpreadsheetApp.getUi().alert(r.intact ? 'Audit log intact (' + r.checked + ' entries)' : 'Audit log BROKEN at row ' + r.first_broken_row);
}

