# Copy to .env.local and fill in. Everything prefixed VITE_ is PUBLIC (bundled into the browser).
# Never put secrets, service-account keys or passwords here.

# Google Apps Script web app URL (Deploy > New deployment > Web app > copy "Web app URL").
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Map tiles. Default: OpenStreetMap (respect its tile usage policy; use a commercial provider for production volume).
# Use {apiKey} in the URL to inject VITE_MAP_API_KEY. A browser map key is visible to users: restrict it by HTTP referrer.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_API_KEY=

# Optional: API request timeout in milliseconds (uploads use 120000 regardless).
VITE_API_TIMEOUT_MS=60000
