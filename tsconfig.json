{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@verification": ["./supabase/functions/_shared/verification/index.ts"]
    }
  },
  "include": ["src", "tests", "supabase/functions/_shared", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"]
}
